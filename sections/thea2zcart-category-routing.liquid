{% liquid
  assign has_categories = false
  assign collection_keys = 'home_collection,car_bike_collection' | split: ','
  if section.settings.home_collection != blank and section.settings.home_collection.products_count > 0
    assign has_categories = true
  endif
  if section.settings.car_bike_collection != blank and section.settings.car_bike_collection.products_count > 0
    assign has_categories = true
  endif
%}

{% if has_categories %}
  <section class="section section--{{ section.settings.section_width }} thea2zcart-category-routing spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="thea2zcart-category-routing__header">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
    </div>
    <div class="thea2zcart-category-routing__grid">
      {% for collection_key in collection_keys %}
        {% assign collection = section.settings[collection_key] %}
        {% if collection != blank and collection.products_count > 0 %}
          {% assign image_alt = collection.featured_image.alt | default: collection.title %}
          <a class="thea2zcart-category-routing__card" href="{{ collection.url }}">
            {% if collection.featured_image != blank %}
              {{ collection.featured_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', loading: 'lazy', alt: image_alt }}
            {% endif %}
            <span class="thea2zcart-category-routing__card-content">
              <span class="thea2zcart-category-routing__title">{{ collection.title | escape }}</span>
              {% if section.settings.link_label != blank %}<span>{{ section.settings.link_label | escape }}</span>{% endif %}
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .thea2zcart-category-routing { display: grid; gap: var(--gap-xl); }
  .thea2zcart-category-routing__header { max-width: 42rem; }
  .thea2zcart-category-routing__header > :first-child { margin-block-start: 0; }
  .thea2zcart-category-routing__header > :last-child { margin-block-end: 0; }
  .thea2zcart-category-routing__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-md); }
  .thea2zcart-category-routing__card { position: relative; display: grid; min-height: 16rem; overflow: hidden; color: inherit; text-decoration: none; background: rgb(var(--color-foreground-rgb) / var(--opacity-5)); }
  .thea2zcart-category-routing__card img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .thea2zcart-category-routing__card-content { position: relative; z-index: 1; align-self: end; display: grid; gap: var(--gap-3xs); padding: var(--padding-lg); background: linear-gradient(transparent, rgb(0 0 0 / 65%)); color: #fff; }
  .thea2zcart-category-routing__title { font: var(--font-heading--family); font-size: var(--font-size--h4); }
  @media screen and (max-width: 749px) { .thea2zcart-category-routing__grid { grid-template-columns: 1fr; } .thea2zcart-category-routing__card { min-height: 13rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Category routing",
  "settings": [
    { "type": "collection", "id": "home_collection", "label": "Home collection" },
    { "type": "collection", "id": "car_bike_collection", "label": "Car & Bike collection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find what fits your day" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explore the collection that matches what you need right now.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore collection" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{"value":"page-width","label":"Page"},{"value":"full-width","label":"Full"}], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Category routing" }]
}
{% endschema %}
