{% doc %}
  Renders a theA2Zcart `a2z_content_item` metafield list on the PDP. Each entry
  is a metaobject (optional heading, optional rich-text body). Only entries with
  content render; the list renders only when at least one entry has content. The
  source field is chosen by the block `field` setting (default `benefits`).
{% enddoc %}

{%- liquid
  assign product_resource = closest.product
  assign field_key = block.settings.field | default: 'benefits'
  assign benefits = product_resource.metafields.thea2zcart[field_key].value
-%}

{%- capture benefit_items -%}
  {%- for benefit in benefits -%}
    {%- liquid
      assign benefit_heading = benefit.heading.value | default: benefit.heading
      assign benefit_body = benefit.body
    -%}
    {%- if benefit_heading != blank or benefit_body != blank -%}
      <li class="product-intelligence-benefits__item">
        {%- if benefit_heading != blank -%}
          <span class="product-intelligence-benefits__item-heading">{{ benefit_heading | escape }}</span>
        {%- endif -%}
        {%- if benefit_body != blank and benefit_body.value != blank -%}
          <span class="product-intelligence-benefits__item-body">{{ benefit_body | metafield_tag }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if benefit_items != blank -%}
  <div class="product-intelligence-benefits" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="product-intelligence-benefits__heading h4">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="product-intelligence-benefits__list" role="list">
      {{ benefit_items }}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-intelligence-benefits {
    display: grid;
    gap: var(--gap-xs);
    width: 100%;
  }

  .product-intelligence-benefits__heading {
    margin-block-end: 0;
  }

  .product-intelligence-benefits__list {
    display: grid;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-intelligence-benefits__item {
    display: block;
  }

  .product-intelligence-benefits__item-heading {
    font-weight: var(--font-weight-bold);
  }

  .product-intelligence-benefits__item-body > * {
    display: inline;
  }

  .product-intelligence-benefits__item-body .metafield-rich_text_field > :first-child {
    margin-block-start: 0;
  }

  .product-intelligence-benefits__item-body .metafield-rich_text_field > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Intelligence list",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "field",
      "label": "Metafield",
      "options": [
        {
          "value": "benefits",
          "label": "Benefits"
        },
        {
          "value": "differentiators",
          "label": "Differentiators"
        }
      ],
      "default": "benefits"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    }
  ],
  "presets": [
    {
      "name": "Intelligence list",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}