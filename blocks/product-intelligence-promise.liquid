{% doc %}
  Renders a single theA2Zcart product metafield (rich text) with an optional
  heading in the PDP. Scalar/rich-text output goes through
  snippets/product-intelligence-field.liquid. The source field is chosen by the
  block `field` setting (default `promise`). Everything is optional; no wrapper,
  heading, or placeholder renders when the field is empty.
{% enddoc %}

{%- liquid
  assign product_resource = closest.product
  assign field_key = block.settings.field | default: 'promise'

  capture promise_content
    render 'product-intelligence-field', product: product_resource, field: field_key
  endcapture
-%}

{%- if promise_content != blank -%}
  <div class="product-intelligence-promise" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="product-intelligence-promise__heading h4">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="product-intelligence-promise__content rte">
      {{ promise_content }}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-intelligence-promise {
    display: grid;
    gap: var(--gap-xs);
    width: 100%;
  }

  .product-intelligence-promise__heading {
    margin-block-end: 0;
  }

  .product-intelligence-promise__content .metafield-rich_text_field > :first-child {
    margin-block-start: 0;
  }

  .product-intelligence-promise__content .metafield-rich_text_field > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Intelligence field",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "field",
      "label": "Metafield",
      "options": [
        {
          "value": "promise",
          "label": "Promise"
        },
        {
          "value": "mechanism",
          "label": "Mechanism"
        },
        {
          "value": "how_it_works",
          "label": "How it works"
        }
      ],
      "default": "promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    }
  ],
  "presets": [
    {
      "name": "Intelligence field",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}